# Server/runtime secrets. Do not prefix any value with NEXT_PUBLIC_.
OPENC_API_KEY=replace-with-server-side-key
OPENC_AI_MODEL=gpt-5-mini
OPENC_AI_DAILY_CALL_LIMIT=50
OPENC_AI_DAILY_TOKEN_LIMIT=250000
OPENC_AI_INPUT_COST_PER_MILLION=0.25
OPENC_AI_OUTPUT_COST_PER_MILLION=2

# Required to call protected discovery and editorial endpoints.
DISCOVERY_CRON_SECRET=generate-a-long-random-secret
ADMIN_REVIEW_TOKEN=generate-a-different-long-random-secret
OPENCOURT_DISCOVERY_URL=https://your-site.example/api/discovery/run

# Optional broad web-search adapter. Endpoint must return Bing-style
# webPages.value[] or results[] objects with URL/link fields.
OPENCOURT_SEARCH_ENDPOINT=
OPENCOURT_SEARCH_API_KEY=
OPENCOURT_FEED_URLS=
OPENCOURT_LINKS_PER_SOURCE=50

# Optional PDF text/OCR service. Without it PDFs are safely cached in R2 and
# held for review rather than guessed from metadata.
PDF_TEXT_EXTRACTOR_URL=
PDF_TEXT_EXTRACTOR_TOKEN=
